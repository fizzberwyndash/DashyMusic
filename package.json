{
  "name": "dashymusic",
  "description": "A glass-inspired, foreground YouTube music companion for iPhone.",
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "@expo/vector-icons": "^15.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-blur": "~58.0.5",
    "expo-linear-gradient": "~58.0.3",
    "expo-haptics": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1",
    "react-native-web": "~0.21.4",
    "react-dom": "19.3.0",
    "expo-constants": "~58.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "tsx": "^4.21.0",
    "@playwright/test": "^1.56.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "iphone": "expo start --lan",
    "test:e2e": "playwright test",
    "export:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
