{
  "name": "dashymusic",
  "description": "A liquid glass iPhone music player with free Audius discovery, local music and native background AutoMix.",
  "license": "0BSD",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.0",
    "@expo-google-fonts/space-mono": "^0.4.0",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "~19.3.0",
    "eas-cli": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm test",
    "iphone": "expo start --go --lan",
    "test:e2e": "playwright test",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "iphone:dev": "expo start --dev-client --lan",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:dev": "eas build --platform ios --profile development"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
