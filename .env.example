# Optional. Video links and the curated collection do not need a Data API key.
# Enable YouTube Data API v3 in Google Cloud and restrict any key you create.
# EXPO_PUBLIC_* values are included in the client bundle; do not put private secrets here.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Optional native player identification override for deployments using a real HTTPS origin.
# Only use an application host you control. Leave blank to use the app identifier fallback.
# If YouTube returns error 153, check identification and validate on your iPhone.
EXPO_PUBLIC_PLAYER_ORIGIN=
