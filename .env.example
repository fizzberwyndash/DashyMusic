# Audius discovery/streaming and local music imports need no API key.
# Optional: enable YouTube Data API v3 and restrict your key for metadata search.
# YouTube video links can be opened without this key.
# EXPO_PUBLIC_* values are embedded in the client; never put private secrets here.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Optional native YouTube player identification override.
# Use a real HTTPS application origin you control, then restart Expo.
# Leave blank to use the configured app-identifier fallback.
# This does not enable YouTube background audio or extract media.
EXPO_PUBLIC_PLAYER_ORIGIN=
